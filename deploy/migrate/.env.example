# =============================================================================
# sub2api + resin 迁移栈配置
# =============================================================================
# 复制成 .env 后填写。import.sh 会自动生成一份并从迁移包里继承 resin 的 token。
#
# 这个文件里的每一项都是凭据或暴露面,chmod 600,不要提交进仓库。
# =============================================================================

# --- 镜像 -------------------------------------------------------------------
# 两个都是**我们自己构建的**。resin 是二开版本(加了延迟天花板熔断、每 IP 租约
# 上限、单请求内换节点重试、失格租约回收),用上游 ghcr.io/resinat/resin 会**丢掉
# 这些改动**,而症状是"看起来能跑,但坏节点又开始把账号钉住"。
SUB2API_IMAGE=sub2api-stack/sub2api:local
RESIN_IMAGE=sub2api-stack/resin:local

# --- resin ------------------------------------------------------------------
# **必须从旧环境继承,不能重新生成。**
# RESIN_PROXY_TOKEN 是账号 credentials 里那串代理口令的来源;换掉它,
# 143 个账号的出口认证会全部失效,而报错形态是「代理 407」,不容易一眼看出根因。
RESIN_ADMIN_TOKEN=
RESIN_PROXY_TOKEN=

# --- postgres ---------------------------------------------------------------
# 只在容器网络内部使用,不需要与旧环境一致,建议 openssl rand -hex 24。
# 刻意不给默认值:上游曾把 database.password 的默认值设成 "postgres",
# 那是一条躺在开源代码里的可用凭据。
POSTGRES_DB=sub2api
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=

# --- sub2api 暴露面 ---------------------------------------------------------
# 客户端要从公网连进来,所以默认绑 0.0.0.0。
# 如果前面打算加反向代理(Caddy/nginx),把它改成 127.0.0.1,
# **并且同时配 server.trusted_proxies** —— 只配一个比都不配更危险:
# 不配 trusted_proxies 而前面有反代,客户端 IP 全变成反代的 IP(限流形同虚设);
# 配了却填得过宽,任何匹配的 peer 都能用 X-Forwarded-For 自报 IP。
SUB2API_BIND=0.0.0.0
SUB2API_PORT=6699

# --- 其他 -------------------------------------------------------------------
TZ=Asia/Shanghai
